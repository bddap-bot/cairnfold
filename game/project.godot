config_version=5

[application]
config/name="Nestcombe"
run/main_scene="res://main.tscn"
run/flush_stdout_on_print=true
boot_splash/image="res://splash.png"

[autoload]
AudioLifetime="*res://src/audio_lifetime.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[editor]

import/use_multiple_threads=false

[rendering]
renderer/rendering_method="mobile"
reflections/sky_reflections/texture_array_reflections=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/vram_compression/import_etc2_astc=true

[shader_globals]

water_ray={
"type": "vec3",
"value": Vector3(0, -1, 0)
}

view_grade={
"type": "vec2",
"value": Vector2(1, 1)
}
lamp_volume={
"type": "sampler3D",
"value": ""
}
lamp_light={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
window_night={
"type": "float",
"value": 0.0
}
bounce_volume={
"type": "sampler3D",
"value": ""
}
bounce_grid={
"type": "vec3",
"value": Vector3(0, 1, 1)
}
bounce_light={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ground_height={
"type": "sampler2D",
"value": ""
}
ground_grid={
"type": "vec3",
"value": Vector3(0, 1, 2)
}
ground_humps={
"type": "mat4",
"value": Projection(0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0)
}
ground_mask={
"type": "sampler2D",
"value": ""
}
flora_grass={
"type": "sampler2D",
"value": ""
}
water_depth={
"type": "sampler2D",
"value": ""
}
season_meadow={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
season_foliage={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sky_overhead={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
season_bloom={
"type": "float",
"value": 1.0
}
detail={
"type": "sampler2D",
"value": ""
}

[xr]
openxr/enabled=true
openxr/extensions/eye_gaze_interaction=true
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/meta/dynamic_resolution=false
shaders/enabled=true
