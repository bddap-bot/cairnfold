config_version=5

[application]
config/name="Cairnfold"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/vram_compression/import_etc2_astc=true

[shader_globals]

ground_height={
"type": "sampler2D",
"value": ""
}
ground_grid={
"type": "vec3",
"value": Vector3(0, 1, 2)
}
ground_hump={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
ground_mask={
"type": "sampler2D",
"value": ""
}
water_level={
"type": "sampler2D",
"value": ""
}
tint_stone={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
tint_roof={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
tint_wood={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
tint_plaster={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
season_meadow={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
season_foliage={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
season_bloom={
"type": "float",
"value": 1.0
}

[xr]
openxr/enabled=true
openxr/extensions/eye_gaze_interaction=true
shaders/enabled=true
