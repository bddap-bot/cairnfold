class_name Avatar
extends Node3D

## Another player as others see them: a VRM avatar whose head and hands follow their tracked poses and
## whose body hangs below the head, turned with it. The built-in avatars are VRM files generated by
## scripts/avatars.gd; a user's own VRM loads through the same path.

const BUILT_IN: Array[String] = ["res://avatars/pebble.vrm", "res://avatars/acorn.vrm", "res://avatars/hood.vrm"]
## VRM faces +Z; a Godot camera looks down -Z.
const FACING := Basis(Vector3.UP, PI)

var head: Node3D
var left: Node3D
var right: Node3D
var hips: Node3D
## The last pose given: eyes, left and right hands.
var eyes := Transform3D.IDENTITY
var hands: Array[Transform3D] = [Transform3D.IDENTITY, Transform3D.IDENTITY]
## At rest: the head bone relative to the eyes, and the hips' offset from the eyes in the model's frame.
var _eye_to_head: Transform3D
var _eye_to_hips: Vector3


## Read VRM files by path; every avatar of one file shares its meshes.
static var _read := {}


## Reads a VRM ahead of need, so a player appearing costs no frame.
static func prepare(path: String) -> PackedScene:
	if not _read.has(path):
		var model := Vrm.read(path)
		for n in model.find_children("*", "", true, false):
			n.owner = model
		var scene := PackedScene.new()
		scene.pack(model)
		model.free()
		_read[path] = scene
	return _read[path]


static func open(path: String, tint: Color) -> Avatar:
	var a := Avatar.new()
	var model: Node3D = prepare(path).instantiate()
	a.add_child(model)
	var bones: Dictionary = model.get_meta("humanoid")
	a.head = model.get_node(bones.head)
	a.left = model.get_node(bones.leftHand)
	a.right = model.get_node(bones.rightHand)
	a.hips = model.get_node(bones.hips)
	var head_rest := _rest(a.head, model)
	var eye_at := head_rest * (model.get_meta("eyes") as Vector3)
	a._eye_to_head = Transform3D(FACING, eye_at).affine_inverse() * head_rest
	a._eye_to_hips = _rest(a.hips, model).origin - eye_at
	a._dress(model, tint)
	return a


## A node's transform relative to the model root, before the model is in the tree.
static func _rest(n: Node3D, root: Node3D) -> Transform3D:
	var t := Transform3D.IDENTITY
	while n != root:
		t = n.transform * t
		n = n.get_parent()
	return t


## Tints the tint surfaces; avatars cast no shadow, since a shadow pass would double their draw calls.
func _dress(n: Node, tint: Color) -> void:
	if n is MeshInstance3D:
		var mi: MeshInstance3D = n
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		for i in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(i)
			if m is StandardMaterial3D and m.resource_name.begins_with("tint"):
				var t: StandardMaterial3D = m.duplicate()
				t.albedo_color = tint
				mi.set_surface_override_material(i, t)
	for c in n.get_children():
		_dress(c, tint)


## Poses of the eyes and the two hands' aim poses, in this node's space (the world's, for a player).
func pose(at: Transform3D, l: Transform3D, r: Transform3D) -> void:
	eyes = at
	hands = [l, r]
	var body := Basis(Vector3.UP, at.basis.get_euler().y) * FACING
	_place(hips, Transform3D(body, at.origin + body * _eye_to_hips))
	_place(head, at * _eye_to_head)
	_place(left, l * Transform3D(FACING, Vector3.ZERO))
	_place(right, r * Transform3D(FACING, Vector3.ZERO))


## Puts a bone at `xform` in this node's space, whatever its parent bones' poses.
func _place(bone: Node3D, xform: Transform3D) -> void:
	bone.transform = _rest(bone.get_parent_node_3d(), self).affine_inverse() * xform


## Standing still with the hands at the sides, as a figure.
func stand() -> void:
	var at := Transform3D(Basis.IDENTITY, Vector3(0, 1.65, 0))
	pose(at, Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(-0.3, 1.0, 0.05)), Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(0.3, 1.0, 0.05)))
