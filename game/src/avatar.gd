class_name Avatar
extends Node3D

## Another player as others see them: a skinned avatar whose head and hands follow their tracked poses, whose eyes
## look where theirs do, whose body hangs below the head, turned as their `Torso` follows it, and whose arms reach from
## the shoulders to the hands. A pose moves the bones of the skeleton the skins bind, and the GPU bends the skin over
## them. Each importer builds the one avatar model `model` loads: a VRM file through `read` (the built-in avatars are VRM
## files generated by scripts/avatars.gd), a Unity package through scripts/unity_avatar.gd. Both shape their meshes by
## `shape` to the limits below, so no avatar costs the frame more than these.

const ExpressionMixer = preload("res://addons/avatar_workshop/expression_mixer.gd")
const SpringRuntime = preload("res://addons/avatar_workshop/spring_runtime.gd")
const SkeletonBone = preload("res://addons/avatar_workshop/skeleton_bone.gd")

const BUILT_IN: Array[String] = ["res://avatars/pebble.vrm", "res://avatars/acorn.vrm", "res://avatars/hood.vrm"]
const MAX_BYTES := 24 << 20
const MAX_TRIANGLES := 20000
## Draw calls: one a material of each skinned mesh (docs/multiplayer.md, "Skinned bodies").
const MAX_SURFACES := 40
const MAX_TEXTURE := 1024
## Spring joints an avatar simulates, whatever its file carries: every joint is simulated each frame on the CPU, about
## 0.05 ms a figure on a Quest 2, and four figures of 59 hold its frame where four of 139 drop it to 22 frames a second.
const MAX_SPRING_JOINTS := 60
## A file's images are measured from their headers, and the file refused past these, before any is decoded: a beacon
## makes every Quest nearby read the file it names, and a few MB of blank images decode for tens of seconds.
const MAX_IMAGES := 32
const MAX_IMAGE_SIDE := 4096
const MAX_PIXELS := 4 * MAX_IMAGE_SIDE * MAX_IMAGE_SIDE
## Blend shapes times the vertices they move, summed over a file's meshes, past which it is refused before they are
## copied: a file of a few MB can name thousands of sparse blend shapes, each held whole once read.
const MAX_BLEND_VERTICES := 4000000
## What an importer leaves unsaid of a model's avatar data (`model`).
const DATA := {"humanoid": {}, "eyes": Vector3(0, 0.06, 0), "forward": Vector3.BACK, "look": {"type": Vrm.BONE, "ranges": [Vector2(90, 10), Vector2(90, 10), Vector2(90, 10), Vector2(90, 10)], "shapes": {}}, "springs": {"springs": [], "colliders": []}}
## A built-in VRM 1.0 avatar faces +Z; a Godot camera looks down -Z.
const FACING := Basis(Vector3.UP, PI)
const NEEDS: Array[String] = ["hips", "head", "leftHand", "rightHand"]
## Where elbows point, in the body's frame (forward -Z): down, out to the side, and a little back.
const ELBOW := Vector3(0.5, -1.0, 0.4)
## The left and right hands' aim poses hanging at the sides, from eyes looking level.
const AT_SIDES: Array[Transform3D] = [Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(-0.3, -0.65, 0.05)), Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(0.3, -0.65, 0.05))]

## One humanoid bone of the skeleton.
class Joint:
	var bone: int
	## At rest, relative to the model.
	var rest: Transform3D
	## Where it is now, relative to the model, while it is placed.
	var at: Transform3D
	## Its frame (its parent bone) is `offset` from the nearest placed bone above it, or from
	## the model; nothing between them moves, so a pose finds the frame without walking the skeleton.
	var base: Joint
	var offset: Transform3D

## One arm's joints and what about them never changes. Upper and lower are null on an arm without them.
class Arm:
	var upper: Joint
	var lower: Joint
	var hand: Joint
	## The hand's turn from a held controller's.
	var grip: Basis
	var upper_length: float
	var lower_length: float
	## Where the elbow points, in the body's frame.
	var elbow: Vector3
	## Each bone's rest turn from the frame that its length and the body's back make.
	var upper_bind: Basis
	var lower_bind: Basis

## A file's identity: a built-in's path, or the hash of a player's own file.
var source := ""
## What it was opened from and tinted with, so another can be opened of it.
var scene: PackedScene
var tint: Color
## The eyes' height over the floor the model stands on, at rest.
var eye_height := 0.0
## The last pose given: eyes, left and right hands, and where the eyes look in the eyes' frame (-Z ahead).
var eyes := Transform3D.IDENTITY
var hands: Array[Transform3D] = [Transform3D.IDENTITY, Transform3D.IDENTITY]
var look := Vector3.FORWARD
## The body's turn about up, as `Torso.follow` keeps it.
var torso := NAN
var springs: SpringRuntime
var simulate_springs := true
var spring_holders := {}
var _model: Node3D
var _skeleton: Skeleton3D
var _joints := {}
var _facing: Basis
## At rest, the head bone relative to the eyes.
var _eye_to_head: Transform3D
var _hips: Joint
var _head: Joint
var _arms: Array[Arm] = []
## The model's lookAt (Vrm, "look"): its type and range maps; its eye bones, left then right, empty unless it looks
## by bone; and for each of Vrm.LOOKS, [mesh, blend shape, weight] for each shape it sets.
var _look_type := Vrm.BONE
var _ranges: Array[Vector2] = []
var _eyes: Array[Joint] = []
var _shapes: Array = []
## The tinted surface materials: a mesh frees its own before its render instance, whose teardown then reads them.
var _tints: Array[Material] = []


static var _built_in := {}


## A built-in avatar, read once; every avatar of it shares its meshes.
static func built_in(i: int) -> PackedScene:
	var path := BUILT_IN[posmod(i, BUILT_IN.size())]
	if not _built_in.has(path):
		_built_in[path] = read(FileAccess.get_file_as_bytes(path))
	return _built_in[path]


## A VRM file as an avatar model to open (`model`), textures shrunk, null if it is not one. Takes tens to hundreds of
## milliseconds, so a player's file is read on a worker thread.
static func read(bytes: PackedByteArray) -> PackedScene:
	if bytes.size() > MAX_BYTES:
		return null
	var seen := {"images": 0, "pixels": 0}
	var fits := func(size: Vector2i) -> bool:
		seen.images += 1
		seen.pixels += size.x * size.y
		return maxi(size.x, size.y) <= MAX_IMAGE_SIDE and seen.images <= MAX_IMAGES and seen.pixels <= MAX_PIXELS
	var root := Vrm.read(bytes, fits, shape, _shrink)
	return model(root) if root != null else null


## An importer's scene as the avatar model to open, or null. The model is a scene of skinned meshes, shaped by `shape`,
## over the skeleton holding the hips, and its root's avatar data: "humanoid", each humanoid bone (Vrm.BONES) and
## "spring_N" for each node N the "springs" definition names, to its bone as the NodePath "skeleton:bone"; "eyes",
## where the eyes sit from the head bone; "forward", the way the model faces; "look", how it points its eyes (Vrm);
## and "springs" (Avatar Workshop's spring definition), its longest chains within MAX_SPRING_JOINTS. DATA fills what the importer left unsaid. Null if the hips,
## head and hands are not bones of one skeleton, or it is still too heavy; frees `root` either way.
static func model(root: Node3D) -> PackedScene:
	for key: String in DATA:
		if not root.has_meta(key):
			root.set_meta(key, DATA[key].duplicate(true) if DATA[key] is Dictionary else DATA[key])
	_on_one_skeleton(root)
	_keep_longest(root.get_meta("springs"))
	var bones: Dictionary = root.get_meta("humanoid")
	var surfaces := 0
	for mi: MeshInstance3D in root.find_children("*", "MeshInstance3D", true, false):
		surfaces += mi.mesh.get_surface_count()
	if not NEEDS.all(func(b: String) -> bool: return bones.has(b)) or surfaces > MAX_SURFACES:
		root.free()
		return null
	for n in root.find_children("*", "", true, false):
		n.owner = root
	var scene := PackedScene.new()
	scene.pack(root)
	root.free()
	return scene


## Keeps the longest spring chains within MAX_SPRING_JOINTS.
static func _keep_longest(springs: Dictionary) -> void:
	var longest: Array = springs.springs.duplicate()
	longest.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a.joints.size() > b.joints.size())
	var kept := []
	var joints := 0
	for chain: Dictionary in longest:
		if joints + chain.joints.size() <= MAX_SPRING_JOINTS:
			kept.append(chain)
			joints += chain.joints.size()
	springs.springs = kept


## Keeps the humanoid and spring bones that are bones of the skeleton holding the hips: a pose moves only those.
static func _on_one_skeleton(model: Node3D) -> void:
	var bones: Dictionary = model.get_meta("humanoid")
	var hips: Variant = bones.get("hips")
	var skeleton := str(hips).get_slice(":", 0) if hips is NodePath and (hips as NodePath).get_subname_count() == 1 else ""
	if skeleton == "" or not model.get_node_or_null(skeleton) is Skeleton3D:
		bones.clear()
		return
	var sk: Skeleton3D = model.get_node(skeleton)
	for b: String in bones.keys():
		var path: NodePath = bones[b]
		if str(path).get_slice(":", 0) != skeleton or path.get_subname_count() != 1 or sk.find_bone(path.get_concatenated_subnames()) < 0:
			bones.erase(b)


## Shapes an importer's parsed meshes and materials before it makes the scene: each mesh merged by material and
## simplified to the triangle limit with its skin and blend shapes, its materials plain. False, leaving them as they
## were, if their blend shapes are past MAX_BLEND_VERTICES.
static func shape(state: GLTFState) -> bool:
	var blended := 0
	for gm in state.get_meshes():
		for i in gm.mesh.get_surface_count():
			blended += gm.mesh.get_blend_shape_count() * (gm.mesh.get_surface_arrays(i)[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
	if blended > MAX_BLEND_VERTICES:
		return false
	var triangles := 0
	for gm in state.get_meshes():
		gm.mesh = _merged(gm.mesh)
		for i in gm.mesh.get_surface_count():
			triangles += gm.mesh.get_surface_arrays(i)[Mesh.ARRAY_INDEX].size() / 3
	var keep := minf(1.0, float(MAX_TRIANGLES) / maxi(triangles, 1))
	for gm in state.get_meshes():
		gm.mesh = _simplified(gm.mesh, keep)
	for m in state.get_materials():
		if m is BaseMaterial3D:
			_plain(m)
	return true


## Draws a material with its colour texture alone, lit once a vertex, front faces only, and cut out where it is
## see-through. Lighting each pixel, normal maps, emission, both sides and blending each cost the Quest 2 GPU time
## over every pixel an avatar covers (docs/multiplayer.md, "A player's own avatar").
static func _plain(m: BaseMaterial3D) -> void:
	# Avatars stand in the garden's light: an unlit (toon) surface would glow at night.
	if m.shading_mode == BaseMaterial3D.SHADING_MODE_UNSHADED:
		m.roughness = 1.0
		m.metallic = 0.0
	m.shading_mode = BaseMaterial3D.SHADING_MODE_PER_VERTEX
	m.normal_enabled = false
	m.normal_texture = null
	m.emission_enabled = false
	m.emission_texture = null
	m.cull_mode = BaseMaterial3D.CULL_BACK
	if m.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR


static func _shrink(img: Image) -> void:
	var big := maxi(img.get_width(), img.get_height())
	if big > MAX_TEXTURE:
		img.resize(maxi(1, img.get_width() * MAX_TEXTURE / big), maxi(1, img.get_height() * MAX_TEXTURE / big), Image.INTERPOLATE_CUBIC)
	if not img.has_mipmaps():
		img.generate_mipmaps()


## One indexed triangle surface per material, each a draw call.
static func _merged(im: ImporterMesh) -> ImporterMesh:
	var groups := {}
	for i in im.get_surface_count():
		if im.get_surface_primitive_type(i) != Mesh.PRIMITIVE_TRIANGLES:
			continue
		var arrays := im.get_surface_arrays(i)
		var n: int = arrays[Mesh.ARRAY_VERTEX].size()
		if arrays[Mesh.ARRAY_INDEX] == null:
			arrays[Mesh.ARRAY_INDEX] = PackedInt32Array(range(n))
		var shapes := range(im.get_blend_shape_count()).map(func(k: int) -> Array: return im.get_surface_blend_shape_arrays(i, k))
		var key := [im.get_surface_material(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, arrays.map(func(a: Variant) -> bool: return a == null)]
		var at: Array = groups.get_or_add(key, [])
		if at.is_empty():
			at.append_array([arrays, im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, im.get_surface_name(i), shapes])
			continue
		Meshes.join(at[0], arrays)
		for k in shapes.size():
			Meshes.join(at[3][k], shapes[k])
	var out := ImporterMesh.new()
	out.resource_name = im.resource_name
	out.set_blend_shape_mode(im.get_blend_shape_mode())
	for k in im.get_blend_shape_count():
		out.add_blend_shape(im.get_blend_shape_name(k))
	for key: Array in groups:
		var g: Array = groups[key]
		out.add_surface(Mesh.PRIMITIVE_TRIANGLES, g[0], g[3], {}, key[0], g[2], g[1])
	return out


## Generates each surface's levels of detail, which the renderer picks by size on screen, and keeps as the full
## surface the first level within `keep` of its triangles, with the levels below it and only the vertices they use:
## the GPU skins every vertex of a surface each frame, used or not.
static func _simplified(im: ImporterMesh, keep: float) -> ImporterMesh:
	im.generate_lods(60.0, 25.0, [])
	var surfaces := []
	var shapes := range(im.get_blend_shape_count()).map(func(k: int) -> String: return im.get_blend_shape_name(k))
	for i in im.get_surface_count():
		var arrays := im.get_surface_arrays(i)
		var want := int(arrays[Mesh.ARRAY_INDEX].size() * keep)
		var lods := {}
		for l in im.get_surface_lod_count(i):
			var idx := im.get_surface_lod_indices(i, l)
			if arrays[Mesh.ARRAY_INDEX].size() > want and idx.size() <= maxi(want, 3):
				arrays[Mesh.ARRAY_INDEX] = idx
			elif idx.size() < arrays[Mesh.ARRAY_INDEX].size():
				lods[im.get_surface_lod_size(i, l)] = idx
		var full: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		var used := {}
		for v in full:
			used.get_or_add(v, used.size())
		for size: float in lods.keys():
			if (lods[size] as PackedInt32Array).size() >= full.size():
				lods.erase(size)
				continue
			for v: int in lods[size]:
				used.get_or_add(v, used.size())
			lods[size] = _renumbered(lods[size], used)
		var blends := range(shapes.size()).map(func(k: int) -> Array: return _kept(im.get_surface_blend_shape_arrays(i, k), used))
		arrays = _kept(arrays, used)
		arrays[Mesh.ARRAY_INDEX] = _renumbered(full, used)
		surfaces.append([arrays, lods, im.get_surface_material(i), im.get_surface_name(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, blends])
	var out := ImporterMesh.new()
	out.resource_name = im.resource_name
	out.set_blend_shape_mode(im.get_blend_shape_mode())
	for name: String in shapes:
		out.add_blend_shape(name)
	for s: Array in surfaces:
		out.add_surface(Mesh.PRIMITIVE_TRIANGLES, s[0], s[5], s[1], s[2], s[3], s[4])
	return out


## A surface's per-vertex arrays cut to the vertices `used` numbers, in its numbering.
static func _kept(arrays: Array, used: Dictionary) -> Array:
	var n: int = arrays[Mesh.ARRAY_VERTEX].size()
	var out := arrays.duplicate()
	for k in mini(arrays.size(), Mesh.ARRAY_MAX):
		var a: Variant = arrays[k]
		if a == null or k == Mesh.ARRAY_INDEX or a.size() == 0:
			continue
		var stride: int = a.size() / n
		var b: Variant = a.slice(0, 0)
		b.resize(used.size() * stride)
		for v: int in used:
			for c in stride:
				b[used[v] * stride + c] = a[v * stride + c]
		out[k] = b
	return out


static func _renumbered(idx: PackedInt32Array, used: Dictionary) -> PackedInt32Array:
	var out := PackedInt32Array()
	out.resize(idx.size())
	for j in idx.size():
		out[j] = used[idx[j]]
	return out


static func open(scene: PackedScene, tint: Color, from := "") -> Avatar:
	var a := Avatar.new()
	a.source = from
	a.scene = scene
	a.tint = tint
	a._model = scene.instantiate()
	a.add_child(a._model)
	a._facing = FACING if (a._model.get_meta("forward", Vector3.BACK) as Vector3).z > 0.0 else Basis.IDENTITY
	var bones: Dictionary = a._model.get_meta("humanoid")
	a._skeleton = a._model.get_node(str(bones.hips).get_slice(":", 0))
	a._skeleton.reset_bone_poses()
	var at := _space(a._skeleton, a._model)
	for b: String in bones:
		var j := Joint.new()
		j.bone = a._skeleton.find_bone((bones[b] as NodePath).get_concatenated_subnames())
		j.rest = at * a._skeleton.get_bone_global_rest(j.bone)
		j.at = j.rest
		a._joints[b] = j
	a._hips = a._joints.hips
	a._head = a._joints.head
	var eye_at := a._head.rest * (a._model.get_meta("eyes") as Vector3)
	a.eye_height = eye_at.y
	a._eye_to_head = Transform3D(a._facing, eye_at).affine_inverse() * a._head.rest
	var look: Dictionary = a._model.get_meta("look")
	a._look_type = look.type
	a._ranges.assign(look.ranges)
	if a._look_type == Vrm.BONE and a._joints.has("leftEye") and a._joints.has("rightEye"):
		a._eyes = [a._joints.leftEye, a._joints.rightEye]
	for dir: String in Vrm.LOOKS:
		var sets := []
		for b: Array in look.shapes.get(dir, []):
			var mi := a._model.get_node_or_null(b[0]) as MeshInstance3D
			if mi and b[1] < mi.get_blend_shape_count():
				sets.append([mi, b[1], b[2]])
		a._shapes.append(sets)
	var placed: Array[Joint] = [a._hips, a._head]
	for s in 2:
		var side: String = ["left", "right"][s]
		var arm := Arm.new()
		arm.hand = a._joints[side + "Hand"]
		var from_bone: Joint = a._joints.get(side + "LowerArm", a._joints.get(side + "UpperArm"))
		var along := a._facing * (arm.hand.rest.origin - from_bone.rest.origin) if from_bone else Vector3(1 - 2 * s, 0, 0)
		# A VRM rests in T-pose, palms down; a hand holding a controller points along it, palm inward.
		var held := _frame(Vector3.FORWARD, Vector3(signf(along.x), 0, 0) * -1.0) * _frame(along, Vector3.DOWN).transposed()
		arm.grip = held * a._facing * arm.hand.rest.basis
		if a._joints.has(side + "UpperArm") and a._joints.has(side + "LowerArm"):
			arm.upper = a._joints[side + "UpperArm"]
			arm.lower = a._joints[side + "LowerArm"]
			var up := arm.upper.rest.origin
			var low := arm.lower.rest.origin
			var hand := arm.hand.rest.origin
			arm.upper_length = low.distance_to(up)
			arm.lower_length = hand.distance_to(low)
			arm.elbow = ELBOW * Vector3(signf((a._facing * (hand - up)).x), 1, 1)
			# The arm's bend is solved in the body's frame, so the body's turn cancels from these.
			arm.upper_bind = _frame(a._facing * (low - up), Vector3.BACK).transposed() * a._facing * arm.upper.rest.basis
			arm.lower_bind = _frame(a._facing * (hand - low), Vector3.BACK).transposed() * a._facing * arm.lower.rest.basis
			placed.append_array([arm.upper, arm.lower])
		placed.append(arm.hand)
		a._arms.append(arm)
	placed.append_array(a._eyes)
	for j: Joint in a._joints.values():
		a._find_base(j, placed)
	a._dress(a._model, tint)
	return a


## Finds the placed bone nearest above a joint's frame, and the frame's offset from it. A pose places the
## joints parents first, so each one's base is already where this pose puts it.
func _find_base(j: Joint, placed: Array[Joint]) -> void:
	var b := _skeleton.get_bone_parent(j.bone)
	var t := Transform3D.IDENTITY
	while b >= 0:
		for p in placed:
			if p.bone == b:
				j.base = p
				j.offset = t
				return
		t = _skeleton.get_bone_rest(b) * t
		b = _skeleton.get_bone_parent(b)
	j.offset = _space(_skeleton, _model) * t


## A node's transform relative to `root`, whether or not it is in the tree.
static func _space(n: Node3D, root: Node3D) -> Transform3D:
	var t := Transform3D.IDENTITY
	while n != root:
		t = n.transform * t
		n = n.get_parent()
	return t


## A basis whose X runs along `along` and Y toward `toward`.
static func _frame(along: Vector3, toward: Vector3) -> Basis:
	var x := along.normalized()
	var y := (toward - x * toward.dot(x)).normalized()
	return Basis(x, y, x.cross(y))


## A joint's frame relative to the model.
static func _frame_of(j: Joint) -> Transform3D:
	return j.base.at * j.offset if j.base else j.offset


func _get_joint(j: Joint) -> Transform3D:
	return _frame_of(j) * _skeleton.get_bone_pose(j.bone)


## Puts a bone at `xform` in this node's space, whatever its parent bones' poses.
func _place(j: Joint, xform: Transform3D) -> void:
	_skeleton.set_bone_pose(j.bone, _frame_of(j).affine_inverse() * xform)
	j.at = xform


## A bone's transform in the world, by its VRM name.
func bone(name: String) -> Transform3D:
	return global_transform * _get_joint(_joints[name])


## The meshes that only spring joints move, which the wearer sees swing and grips.
func swaying() -> Array[MeshInstance3D]:
	var swings := {}
	for chain: Dictionary in _model.get_meta("springs", {"springs": []}).springs:
		for joint: Dictionary in chain.joints:
			var j: Joint = _joints.get("spring_" + str(joint.node))
			if j:
				swings[_skeleton.get_bone_name(j.bone)] = true
	var out: Array[MeshInstance3D] = []
	for mi: MeshInstance3D in _model.find_children("*", "MeshInstance3D", true, false):
		if mi.skin and mi.skin.get_bind_count() > 0 and mi.get_node_or_null(mi.skeleton) == _skeleton and range(mi.skin.get_bind_count()).all(func(i: int) -> bool: return bind_bone(mi.skin, i) >= 0 and swings.has(_skeleton.get_bone_name(bind_bone(mi.skin, i)))):
			out.append(mi)
	return out


## The skeleton bone a skin's bind `i` follows, by index or else by name.
func bind_bone(skin: Skin, i: int) -> int:
	return skin.get_bind_bone(i) if skin.get_bind_bone(i) >= 0 else _skeleton.find_bone(skin.get_bind_name(i))


## Tints the tint surfaces; avatars cast no shadow, since a shadow pass would double their draw calls.
func _dress(n: Node, tint: Color) -> void:
	if n is VisualInstance3D:
		(n as VisualInstance3D).layers = Quality.PEOPLE_LAYER
	if n is MeshInstance3D:
		var mi: MeshInstance3D = n
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		for i in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(i)
			if m is StandardMaterial3D and m.resource_name.begins_with("tint"):
				var t: StandardMaterial3D = m.duplicate()
				t.albedo_color = tint
				_tints.append(t)
				mi.set_surface_override_material(i, t)
	for c in n.get_children():
		_dress(c, tint)


## Poses of the eyes and the two hands' aim poses, in this node's space (the world's, for a player), and where the
## eyes look in their own frame. Only the tracked parts are placed: the body hangs upright from the head bone in its
## rest pose, and each arm is the one bend that joins its shoulder to its hand.
func pose(at: Transform3D, l: Transform3D, r: Transform3D, toward := Vector3.FORWARD) -> void:
	eyes = at
	hands[0] = l
	hands[1] = r
	look = toward
	torso = Torso.follow(torso, at.basis)
	var turn := Basis(Vector3.UP, torso)
	var head := at * _eye_to_head
	var body := turn * _facing
	_place(_hips, Transform3D(body, head.origin - body * _head.rest.origin) * _hips.rest)
	_place(_head, head)
	_look(head)
	for s in 2:
		var arm := _arms[s]
		var grip := Transform3D(hands[s].basis * arm.grip, hands[s].origin)
		if arm.upper:
			_arm(arm, grip.origin, turn)
		_place(arm.hand, grip)

	if springs == null and is_inside_tree():
		var nodes := {}
		for name: String in _joints:
			if name.begins_with("spring_"):
				nodes[int(name.trim_prefix("spring_"))] = SkeletonBone.new(_skeleton, _joints[name].bone)
		springs = SpringRuntime.new(_model.get_meta("springs", {"springs": [], "colliders": []}), nodes)


func _process(delta: float) -> void:
	if springs != null and simulate_springs:
		springs.advance(delta)


## Points the eyes along `look` as the model's lookAt maps it: each angle off ahead, up to its range map's largest
## input, turns the eye bones or weighs the look expressions in proportion, up to the map's output. An eye looking
## toward its own side maps by the outer range, toward the nose by the inner.
func _look(head: Transform3D) -> void:
	var yaw := rad_to_deg(atan2(look.x, -look.z))
	var pitch := rad_to_deg(atan2(look.y, Vector2(look.x, look.z).length()))
	var v := _mapped(_ranges[3] if pitch > 0.0 else _ranges[2], pitch)
	for s in _eyes.size():
		var outward := (yaw < 0.0) == (s == 0)
		var h := _mapped(_ranges[1] if outward else _ranges[0], yaw)
		var turn := _facing * Basis(Vector3.UP, -deg_to_rad(h)) * Basis(Vector3.RIGHT, deg_to_rad(v)) * _facing.inverse()
		var rest := _eyes[s].rest
		_place(_eyes[s], head * _head.rest.affine_inverse() * Transform3D(turn * rest.basis, rest.origin))
	if _look_type != Vrm.EXPRESSION:
		return
	# As UniVRM does, expressions take the outer horizontal map both ways.
	var h := _mapped(_ranges[1], yaw)
	var weights := [maxf(-h, 0.0), maxf(h, 0.0), maxf(v, 0.0), maxf(-v, 0.0)]
	var sums := ExpressionMixer.mix(weights, _shapes)
	for mk: Array in sums:
		(mk[0] as MeshInstance3D).set_blend_shape_value(mk[1], sums[mk])


## An angle in degrees, signed, through a range map: clamped to its largest input, scaled to its output.
static func _mapped(r: Vector2, angle: float) -> float:
	return clampf(angle, -r.x, r.x) / r.x * r.y


## Folds hand `side` (0 left, 1 right) and its fingers into the wrist, until the next `pose`.
func fold(side: int) -> void:
	var at := _get_joint(_arms[side].hand)
	_place(_arms[side].hand, Transform3D(at.basis.scaled_local(Vector3.ONE * 0.001), at.origin))


## Whether hand `side` is folded away this pose.
func folded(side: int) -> bool:
	return _get_joint(_arms[side].hand).basis.get_scale().x < 0.01


## Bends the arm to reach `to`. Where the arm is too short the hand still goes to the controller, where held things
## are, and the skin of the forearm stretches after it.
func _arm(arm: Arm, to: Vector3, turn: Basis) -> void:
	var shoulder := _get_joint(arm.upper).origin
	var a := arm.upper_length
	var b := arm.lower_length
	var reach := to - shoulder
	var c := clampf(reach.length(), absf(a - b) + 0.001, a + b - 0.0001)
	var u := reach.normalized() if reach.length() > 0.001 else turn * Vector3.DOWN
	var pole := turn * arm.elbow
	var p := (pole - u * pole.dot(u)).normalized()
	var cos_a := (a * a + c * c - b * b) / (2.0 * a * c)
	var elbow := shoulder + u * a * cos_a + p * a * sqrt(maxf(0.0, 1.0 - cos_a * cos_a))
	_place(arm.upper, Transform3D(_frame(elbow - shoulder, p) * arm.upper_bind, shoulder))
	_place(arm.lower, Transform3D(_frame(to - elbow, p) * arm.lower_bind, elbow))


## Standing still with the hands at the sides, as a figure.
func stand() -> void:
	var at := Transform3D(Basis.IDENTITY, Vector3(0, eye_height, 0))
	pose(at, at * AT_SIDES[0], at * AT_SIDES[1])
