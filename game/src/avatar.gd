class_name Avatar
extends Node3D

## Another player as others see them: a VRM avatar whose head and hands follow their tracked poses, whose eyes look
## where theirs do, whose body hangs below the head, turned as their `Torso` follows it, and whose arms reach from the shoulders to the
## hands. The built-in avatars are VRM files generated by scripts/avatars.gd; a player's own VRM loads through the
## same path (`read`), cut to the limits below so no avatar costs the frame more than these.

const BUILT_IN: Array[String] = ["res://avatars/pebble.vrm", "res://avatars/acorn.vrm", "res://avatars/hood.vrm"]
const MAX_BYTES := 24 << 20
const MAX_TRIANGLES := 20000
const MAX_SURFACES := 20
const MAX_TEXTURE := 1024
## A built-in VRM 1.0 avatar faces +Z; a Godot camera looks down -Z.
const FACING := Basis(Vector3.UP, PI)
const NEEDS: Array[String] = ["hips", "head", "leftHand", "rightHand"]
## Where elbows point, in the body's frame (forward -Z): down, out to the side, and a little back.
const ELBOW := Vector3(0.5, -1.0, 0.4)
## The left and right hands' aim poses hanging at the sides, from eyes looking level.
const AT_SIDES: Array[Transform3D] = [Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(-0.3, -0.65, 0.05)), Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(0.3, -0.65, 0.05))]

## One humanoid bone: a node, or a bone of a skeleton.
class Joint:
	var node: Node3D
	var bone := -1
	## At rest, relative to the model.
	var rest: Transform3D
	## Where it is now, relative to the model, while it is a placed node.
	var at: Transform3D
	## Its frame (its skeleton, or its node's parent) is `offset` from the nearest placed node above it, or from
	## the model; nothing between them moves, so a pose finds the frame without walking the tree.
	var base: Joint
	var offset: Transform3D

## One arm's joints and what about them never changes. Upper and lower are null on an arm without them.
class Arm:
	var upper: Joint
	var lower: Joint
	var hand: Joint
	## The hand's turn from a held controller's.
	var grip: Basis
	var upper_length: float
	var lower_length: float
	## Where the elbow points, in the body's frame.
	var elbow: Vector3
	## Each bone's rest turn from the frame that its length and the body's back make.
	var upper_bind: Basis
	var lower_bind: Basis

## A file's identity: a built-in's path, or the hash of a player's own file.
var source := ""
## The last pose given: eyes, left and right hands, and where the eyes look in the eyes' frame (-Z ahead).
var eyes := Transform3D.IDENTITY
var hands: Array[Transform3D] = [Transform3D.IDENTITY, Transform3D.IDENTITY]
var look := Vector3.FORWARD
## The body's turn about up, as `Torso.follow` keeps it.
var torso := NAN
var _model: Node3D
var _joints := {}
var _facing: Basis
## At rest, the head bone relative to the eyes.
var _eye_to_head: Transform3D
var _hips: Joint
var _head: Joint
var _arms: Array[Arm] = []
## The model's lookAt (Vrm, "look"): its type and range maps; its eye bones, left then right, empty unless it looks
## by bone; and for each of Vrm.LOOKS, [mesh, blend shape, weight] for each shape it sets.
var _look_type := Vrm.BONE
var _ranges: Array[Vector2] = []
var _eyes: Array[Joint] = []
var _shapes: Array = []


static var _built_in := {}


## A built-in avatar, read once; every avatar of it shares its meshes.
static func built_in(i: int) -> PackedScene:
	var path := BUILT_IN[posmod(i, BUILT_IN.size())]
	if not _built_in.has(path):
		_built_in[path] = read(FileAccess.get_file_as_bytes(path))
	return _built_in[path]


## A VRM file as a scene to open, within the limits: meshes merged by material and simplified to the triangle
## limit, textures shrunk, animations and every expression but the eyes' dropped. Null if it is not a humanoid VRM
## or still too heavy. Takes tens to hundreds of milliseconds, so a player's file is read on a worker thread.
static func read(bytes: PackedByteArray) -> PackedScene:
	if bytes.size() > MAX_BYTES:
		return null
	var model := Vrm.read(bytes, _shape, _shrink)
	if model == null:
		return null
	var bones: Dictionary = model.get_meta("humanoid")
	var surfaces := 0
	for mi: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
		surfaces += mi.mesh.get_surface_count()
	if not NEEDS.all(func(b: String) -> bool: return bones.has(b)) or surfaces > MAX_SURFACES:
		model.free()
		return null
	for n in model.find_children("*", "", true, false):
		n.owner = model
	var scene := PackedScene.new()
	scene.pack(model)
	model.free()
	return scene


static func _shape(state: GLTFState) -> bool:
	var looks := {}
	var binds := Vrm.look_binds(state)
	for dir: String in binds:
		for b: Array in binds[dir]:
			looks.get_or_add(state.get_nodes()[b[0]].mesh, {})[b[1]] = true
	var meshes: Array[ImporterMesh] = []
	var triangles := 0
	var gms := state.get_meshes()
	for m in gms.size():
		var gm := gms[m]
		var keep: Array = looks.get(m, {}).keys().filter(func(k: int) -> bool: return k < gm.mesh.get_blend_shape_count())
		keep.sort()
		gm.blend_weights = PackedFloat32Array()
		gm.blend_weights.resize(keep.size())
		gm.mesh = _merged(gm.mesh, keep)
		meshes.append(gm.mesh)
		for i in gm.mesh.get_surface_count():
			triangles += gm.mesh.get_surface_arrays(i)[Mesh.ARRAY_INDEX].size() / 3
	var keep := minf(1.0, float(MAX_TRIANGLES) / maxi(triangles, 1))
	for im in meshes:
		_simplify(im, keep)
	# Avatars stand in the garden's light: an unlit (toon) surface would glow at night.
	for m in state.get_materials():
		if m is BaseMaterial3D and m.shading_mode == BaseMaterial3D.SHADING_MODE_UNSHADED:
			m.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
			m.roughness = 1.0
			m.metallic = 0.0
	return true


static func _shrink(img: Image) -> void:
	var big := maxi(img.get_width(), img.get_height())
	if big > MAX_TEXTURE:
		img.resize(maxi(1, img.get_width() * MAX_TEXTURE / big), maxi(1, img.get_height() * MAX_TEXTURE / big), Image.INTERPOLATE_CUBIC)
	if not img.has_mipmaps():
		img.generate_mipmaps()


## One indexed triangle surface per material, keeping only the blend shapes `morphs` names: each surface is a draw
## call, and every blend shape a pass over its vertices.
static func _merged(im: ImporterMesh, morphs: Array) -> ImporterMesh:
	var groups := {}
	for i in im.get_surface_count():
		if im.get_surface_primitive_type(i) != Mesh.PRIMITIVE_TRIANGLES:
			continue
		var arrays := im.get_surface_arrays(i)
		var n: int = arrays[Mesh.ARRAY_VERTEX].size()
		if arrays[Mesh.ARRAY_INDEX] == null:
			arrays[Mesh.ARRAY_INDEX] = PackedInt32Array(range(n))
		var shapes := morphs.map(func(k: int) -> Array: return im.get_surface_blend_shape_arrays(i, k))
		var key := [im.get_surface_material(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, arrays.map(func(a: Variant) -> bool: return a == null)]
		var at: Array = groups.get_or_add(key, [])
		if at.is_empty():
			at.append_array([arrays, im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, im.get_surface_name(i), shapes])
			continue
		var into: Array = at[0]
		var base: int = into[Mesh.ARRAY_VERTEX].size()
		var idx: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		for j in idx.size():
			idx[j] += base
		arrays[Mesh.ARRAY_INDEX] = idx
		_join(into, arrays)
		for k in shapes.size():
			_join(at[3][k], shapes[k])
	var out := ImporterMesh.new()
	out.resource_name = im.resource_name
	out.set_blend_shape_mode(im.get_blend_shape_mode())
	for k: int in morphs:
		out.add_blend_shape(Vrm.morph_name(k))
	for key: Array in groups:
		var g: Array = groups[key]
		out.add_surface(Mesh.PRIMITIVE_TRIANGLES, g[0], g[3], {}, key[0], g[2], g[1])
	return out


static func _join(into: Array, arrays: Array) -> void:
	for k in mini(into.size(), arrays.size()):
		if into[k] != null and arrays[k] != null:
			var joined: Variant = into[k]
			joined.append_array(arrays[k])
			into[k] = joined


## Generates each surface's levels of detail, which the renderer picks by size on screen, and keeps as the full
## surface the first level within `keep` of its triangles.
static func _simplify(im: ImporterMesh, keep: float) -> void:
	im.generate_lods(60.0, 25.0, [])
	var surfaces := []
	var shapes := range(im.get_blend_shape_count()).map(func(k: int) -> String: return im.get_blend_shape_name(k))
	for i in im.get_surface_count():
		var arrays := im.get_surface_arrays(i)
		var want := int(arrays[Mesh.ARRAY_INDEX].size() * keep)
		var lods := {}
		for l in im.get_surface_lod_count(i):
			var idx := im.get_surface_lod_indices(i, l)
			if arrays[Mesh.ARRAY_INDEX].size() > want and idx.size() <= maxi(want, 3):
				arrays[Mesh.ARRAY_INDEX] = idx
			elif idx.size() < arrays[Mesh.ARRAY_INDEX].size():
				lods[im.get_surface_lod_size(i, l)] = idx
		var blends := range(shapes.size()).map(func(k: int) -> Array: return im.get_surface_blend_shape_arrays(i, k))
		surfaces.append([arrays, lods, im.get_surface_material(i), im.get_surface_name(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, blends])
	im.clear()
	for name: String in shapes:
		im.add_blend_shape(name)
	for s: Array in surfaces:
		im.add_surface(Mesh.PRIMITIVE_TRIANGLES, s[0], s[5], s[1], s[2], s[3], s[4])


static func open(scene: PackedScene, tint: Color, from := "") -> Avatar:
	var a := Avatar.new()
	a.source = from
	a._model = scene.instantiate()
	a.add_child(a._model)
	a._facing = FACING if (a._model.get_meta("forward", Vector3.BACK) as Vector3).z > 0.0 else Basis.IDENTITY
	var bones: Dictionary = a._model.get_meta("humanoid")
	for b: String in bones:
		var j := Joint.new()
		var path: NodePath = bones[b]
		j.node = a._model.get_node(path)
		if j.node is Skeleton3D:
			j.bone = (j.node as Skeleton3D).find_bone(path.get_concatenated_subnames())
			j.rest = _space(j.node, a._model) * (j.node as Skeleton3D).get_bone_global_rest(j.bone)
		else:
			j.rest = _space(j.node, a._model)
		j.at = j.rest
		a._joints[b] = j
	a._hips = a._joints.hips
	a._head = a._joints.head
	var eye_at := a._head.rest * (a._model.get_meta("eyes") as Vector3)
	a._eye_to_head = Transform3D(a._facing, eye_at).affine_inverse() * a._head.rest
	var look: Dictionary = a._model.get_meta("look")
	a._look_type = look.type
	a._ranges.assign(look.ranges)
	if a._look_type == Vrm.BONE and a._joints.has("leftEye") and a._joints.has("rightEye"):
		a._eyes = [a._joints.leftEye, a._joints.rightEye]
	for dir: String in Vrm.LOOKS:
		var sets := []
		for b: Array in look.shapes.get(dir, []):
			var mi := a._model.get_node_or_null(b[0]) as MeshInstance3D
			var k := mi.find_blend_shape_by_name(b[1]) if mi else -1
			if k >= 0:
				sets.append([mi, k, b[2]])
		a._shapes.append(sets)
	var placed: Array[Joint] = [a._hips, a._head]
	for s in 2:
		var side: String = ["left", "right"][s]
		var arm := Arm.new()
		arm.hand = a._joints[side + "Hand"]
		var from_bone: Joint = a._joints.get(side + "LowerArm", a._joints.get(side + "UpperArm"))
		var along := a._facing * (arm.hand.rest.origin - from_bone.rest.origin) if from_bone else Vector3(1 - 2 * s, 0, 0)
		# A VRM rests in T-pose, palms down; a hand holding a controller points along it, palm inward.
		var held := _frame(Vector3.FORWARD, Vector3(signf(along.x), 0, 0) * -1.0) * _frame(along, Vector3.DOWN).transposed()
		arm.grip = held * a._facing * arm.hand.rest.basis
		if a._joints.has(side + "UpperArm") and a._joints.has(side + "LowerArm"):
			arm.upper = a._joints[side + "UpperArm"]
			arm.lower = a._joints[side + "LowerArm"]
			var up := arm.upper.rest.origin
			var low := arm.lower.rest.origin
			var hand := arm.hand.rest.origin
			arm.upper_length = low.distance_to(up)
			arm.lower_length = hand.distance_to(low)
			arm.elbow = ELBOW * Vector3(signf((a._facing * (hand - up)).x), 1, 1)
			# The arm's bend is solved in the body's frame, so the body's turn cancels from these.
			arm.upper_bind = _frame(a._facing * (low - up), Vector3.BACK).transposed() * a._facing * arm.upper.rest.basis
			arm.lower_bind = _frame(a._facing * (hand - low), Vector3.BACK).transposed() * a._facing * arm.lower.rest.basis
			placed.append_array([arm.upper, arm.lower])
		placed.append(arm.hand)
		a._arms.append(arm)
	placed.append_array(a._eyes)
	for j: Joint in a._joints.values():
		a._find_base(j, placed)
	a._dress(a._model, tint)
	return a


## Finds the placed node nearest above a joint's frame, and the frame's offset from it. A pose places the
## joints parents first, so each one's base is already where this pose puts it.
func _find_base(j: Joint, placed: Array[Joint]) -> void:
	var n := j.node if j.bone >= 0 else j.node.get_parent_node_3d()
	var t := Transform3D.IDENTITY
	while n != _model:
		for p in placed:
			if p.bone < 0 and p.node == n:
				j.base = p
				j.offset = t
				return
		t = n.transform * t
		n = n.get_parent()
	j.offset = t


## A node's transform relative to `root`, whether or not it is in the tree.
static func _space(n: Node3D, root: Node3D) -> Transform3D:
	var t := Transform3D.IDENTITY
	while n != root:
		t = n.transform * t
		n = n.get_parent()
	return t


## A basis whose X runs along `along` and Y toward `toward`.
static func _frame(along: Vector3, toward: Vector3) -> Basis:
	var x := along.normalized()
	var y := (toward - x * toward.dot(x)).normalized()
	return Basis(x, y, x.cross(y))


## A joint's frame relative to the model.
static func _frame_of(j: Joint) -> Transform3D:
	return j.base.at * j.offset if j.base else j.offset


func _get_joint(j: Joint) -> Transform3D:
	if j.bone >= 0:
		return _frame_of(j) * (j.node as Skeleton3D).get_bone_global_pose(j.bone)
	return _frame_of(j) * j.node.transform


## Puts a bone at `xform` in this node's space, whatever its parent bones' poses.
func _place(j: Joint, xform: Transform3D) -> void:
	if j.bone >= 0:
		(j.node as Skeleton3D).set_bone_global_pose(j.bone, _frame_of(j).affine_inverse() * xform)
	else:
		j.node.transform = _frame_of(j).affine_inverse() * xform
		j.at = xform


## A bone's transform in the world, by its VRM name.
func bone(name: String) -> Transform3D:
	return global_transform * _get_joint(_joints[name])


## Tints the tint surfaces; avatars cast no shadow, since a shadow pass would double their draw calls.
func _dress(n: Node, tint: Color) -> void:
	if n is MeshInstance3D:
		var mi: MeshInstance3D = n
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		for i in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(i)
			if m is StandardMaterial3D and m.resource_name.begins_with("tint"):
				var t: StandardMaterial3D = m.duplicate()
				t.albedo_color = tint
				mi.set_surface_override_material(i, t)
	for c in n.get_children():
		_dress(c, tint)


## Poses of the eyes and the two hands' aim poses, in this node's space (the world's, for a player), and where the
## eyes look in their own frame. Only the tracked parts are placed: the body hangs upright from the head bone in its
## rest pose, and each arm is the one bend that joins its shoulder to its hand.
func pose(at: Transform3D, l: Transform3D, r: Transform3D, toward := Vector3.FORWARD) -> void:
	eyes = at
	hands[0] = l
	hands[1] = r
	look = toward
	torso = Torso.follow(torso, at.basis)
	var turn := Basis(Vector3.UP, torso)
	var head := at * _eye_to_head
	var body := turn * _facing
	_place(_hips, Transform3D(body, head.origin - body * _head.rest.origin) * _hips.rest)
	_place(_head, head)
	_look(head)
	for s in 2:
		var arm := _arms[s]
		var grip := Transform3D(hands[s].basis * arm.grip, hands[s].origin)
		if arm.upper:
			_arm(arm, grip.origin, turn)
		_place(arm.hand, grip)


## Points the eyes along `look` as the model's lookAt maps it: each angle off ahead, up to its range map's largest
## input, turns the eye bones or weighs the look expressions in proportion, up to the map's output. An eye looking
## toward its own side maps by the outer range, toward the nose by the inner.
func _look(head: Transform3D) -> void:
	var yaw := rad_to_deg(atan2(look.x, -look.z))
	var pitch := rad_to_deg(atan2(look.y, Vector2(look.x, look.z).length()))
	var v := _mapped(_ranges[3] if pitch > 0.0 else _ranges[2], pitch)
	for s in _eyes.size():
		var outward := (yaw < 0.0) == (s == 0)
		var h := _mapped(_ranges[1] if outward else _ranges[0], yaw)
		var turn := _facing * Basis(Vector3.UP, -deg_to_rad(h)) * Basis(Vector3.RIGHT, deg_to_rad(v)) * _facing.inverse()
		var rest := _eyes[s].rest
		_place(_eyes[s], head * _head.rest.affine_inverse() * Transform3D(turn * rest.basis, rest.origin))
	if _look_type != Vrm.EXPRESSION:
		return
	# As UniVRM does, expressions take the outer horizontal map both ways.
	var h := _mapped(_ranges[1], yaw)
	var weights := [maxf(-h, 0.0), maxf(h, 0.0), maxf(v, 0.0), maxf(-v, 0.0)]
	var sums := {}
	for i in _shapes.size():
		for b: Array in _shapes[i]:
			sums[b.slice(0, 2)] = sums.get(b.slice(0, 2), 0.0) + weights[i] * b[2]
	for mk: Array in sums:
		(mk[0] as MeshInstance3D).set_blend_shape_value(mk[1], minf(sums[mk], 1.0))


## An angle in degrees, signed, through a range map: clamped to its largest input, scaled to its output.
static func _mapped(r: Vector2, angle: float) -> float:
	return clampf(angle, -r.x, r.x) / r.x * r.y


## Folds hand `side` (0 left, 1 right) and its fingers into the wrist, until the next `pose`.
func fold(side: int) -> void:
	var at := _get_joint(_arms[side].hand)
	_place(_arms[side].hand, Transform3D(at.basis.scaled_local(Vector3.ONE * 0.001), at.origin))


## Whether hand `side` is folded away this pose.
func folded(side: int) -> bool:
	return _get_joint(_arms[side].hand).basis.get_scale().x < 0.01


func _arm(arm: Arm, to: Vector3, turn: Basis) -> void:
	var shoulder := _get_joint(arm.upper).origin
	var a := arm.upper_length
	var b := arm.lower_length
	var reach := to - shoulder
	var c := clampf(reach.length(), absf(a - b) + 0.001, a + b - 0.0001)
	var u := reach.normalized() if reach.length() > 0.001 else turn * Vector3.DOWN
	var pole := turn * arm.elbow
	var p := (pole - u * pole.dot(u)).normalized()
	var cos_a := (a * a + c * c - b * b) / (2.0 * a * c)
	var elbow := shoulder + u * a * cos_a + p * a * sqrt(maxf(0.0, 1.0 - cos_a * cos_a))
	_place(arm.upper, Transform3D(_frame(elbow - shoulder, p) * arm.upper_bind, shoulder))
	_place(arm.lower, Transform3D(_frame(to - elbow, p) * arm.lower_bind, elbow))


## Standing still with the hands at the sides, as a figure.
func stand() -> void:
	var at := Transform3D(Basis.IDENTITY, Vector3(0, Rig.EYE, 0))
	pose(at, at * AT_SIDES[0], at * AT_SIDES[1])
