class_name Avatar
extends Node3D

## Another player as others see them: a VRM avatar whose head and hands follow their tracked poses, whose body
## hangs below the head, turned with it, and whose arms reach from the shoulders to the hands. The built-in avatars
## are VRM files generated by scripts/avatars.gd; a player's own VRM loads through the same path (`read`), cut to
## the limits below so no avatar costs the frame more than these.

const BUILT_IN: Array[String] = ["res://avatars/pebble.vrm", "res://avatars/acorn.vrm", "res://avatars/hood.vrm"]
const MAX_BYTES := 24 << 20
const MAX_TRIANGLES := 20000
const MAX_SURFACES := 20
const MAX_TEXTURE := 1024
## A built-in VRM 1.0 avatar faces +Z; a Godot camera looks down -Z.
const FACING := Basis(Vector3.UP, PI)
const NEEDS: Array[String] = ["hips", "head", "leftHand", "rightHand"]
## Where elbows point, in the body's frame (forward -Z): down, out to the side, and a little back.
const ELBOW := Vector3(0.5, -1.0, 0.4)

## One humanoid bone: a node, or a bone of a skeleton.
class Joint:
	var node: Node3D
	var bone := -1
	## At rest, relative to the model.
	var rest: Transform3D

## A file's identity: a built-in's path, or the hash of a player's own file.
var source := ""
## The last pose given: eyes, left and right hands.
var eyes := Transform3D.IDENTITY
var hands: Array[Transform3D] = [Transform3D.IDENTITY, Transform3D.IDENTITY]
var _model: Node3D
var _joints := {}
var _facing: Basis
## At rest: the head bone relative to the eyes, and each hand's turn from a held controller's.
var _eye_to_head: Transform3D
var _grip: Array[Basis] = [Basis.IDENTITY, Basis.IDENTITY]


static var _built_in := {}


## A built-in avatar, read once; every avatar of it shares its meshes.
static func built_in(i: int) -> PackedScene:
	var path := BUILT_IN[posmod(i, BUILT_IN.size())]
	if not _built_in.has(path):
		_built_in[path] = read(FileAccess.get_file_as_bytes(path))
	return _built_in[path]


## A VRM file as a scene to open, within the limits: meshes merged by material and simplified to the triangle
## limit, textures shrunk, expressions and animations dropped. Null if it is not a humanoid VRM or still too
## heavy. Takes tens to hundreds of milliseconds, so a player's file is read on a worker thread.
static func read(bytes: PackedByteArray) -> PackedScene:
	if bytes.size() > MAX_BYTES:
		return null
	var model := Vrm.read(bytes, _shape)
	if model == null:
		return null
	var bones: Dictionary = model.get_meta("humanoid")
	var surfaces := 0
	for mi: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
		surfaces += mi.mesh.get_surface_count()
	if not NEEDS.all(func(b: String) -> bool: return bones.has(b)) or surfaces > MAX_SURFACES:
		model.free()
		return null
	for n in model.find_children("*", "", true, false):
		n.owner = model
	var scene := PackedScene.new()
	scene.pack(model)
	model.free()
	return scene


static func _shape(state: GLTFState) -> bool:
	var meshes: Array[ImporterMesh] = []
	var triangles := 0
	for gm in state.get_meshes():
		gm.blend_weights = PackedFloat32Array()
		gm.mesh = _merged(gm.mesh)
		meshes.append(gm.mesh)
		for i in gm.mesh.get_surface_count():
			triangles += gm.mesh.get_surface_arrays(i)[Mesh.ARRAY_INDEX].size() / 3
	var keep := minf(1.0, float(MAX_TRIANGLES) / maxi(triangles, 1))
	for im in meshes:
		_simplify(im, keep)
	for tex in state.get_images():
		var img := tex.get_image() if tex is ImageTexture else null
		if img == null:
			continue
		var big := maxi(img.get_width(), img.get_height())
		if big > MAX_TEXTURE:
			img.resize(maxi(1, img.get_width() * MAX_TEXTURE / big), maxi(1, img.get_height() * MAX_TEXTURE / big), Image.INTERPOLATE_CUBIC)
		if not img.has_mipmaps():
			img.generate_mipmaps()
		(tex as ImageTexture).set_image(img)
	# Avatars stand in the garden's light: an unlit (toon) surface would glow at night.
	for m in state.get_materials():
		if m is BaseMaterial3D and m.shading_mode == BaseMaterial3D.SHADING_MODE_UNSHADED:
			m.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
			m.roughness = 1.0
			m.metallic = 0.0
	return true


## One indexed triangle surface per material, without blend shapes: each surface is a draw call.
static func _merged(im: ImporterMesh) -> ImporterMesh:
	var groups := {}
	for i in im.get_surface_count():
		if im.get_surface_primitive_type(i) != Mesh.PRIMITIVE_TRIANGLES:
			continue
		var arrays := im.get_surface_arrays(i)
		var n: int = arrays[Mesh.ARRAY_VERTEX].size()
		if arrays[Mesh.ARRAY_INDEX] == null:
			arrays[Mesh.ARRAY_INDEX] = PackedInt32Array(range(n))
		var key := [im.get_surface_material(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, arrays.map(func(a: Variant) -> bool: return a == null)]
		var at: Array = groups.get_or_add(key, [])
		if at.is_empty():
			at.append_array([arrays, im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS, im.get_surface_name(i)])
			continue
		var into: Array = at[0]
		var base: int = into[Mesh.ARRAY_VERTEX].size()
		var idx: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
		for j in idx.size():
			idx[j] += base
		arrays[Mesh.ARRAY_INDEX] = idx
		for k in Mesh.ARRAY_MAX:
			if into[k] != null:
				var joined: Variant = into[k]
				joined.append_array(arrays[k])
				into[k] = joined
	var out := ImporterMesh.new()
	out.resource_name = im.resource_name
	for key: Array in groups:
		var g: Array = groups[key]
		out.add_surface(Mesh.PRIMITIVE_TRIANGLES, g[0], [], {}, key[0], g[2], g[1])
	return out


## Generates each surface's levels of detail, which the renderer picks by size on screen, and keeps as the full
## surface the first level within `keep` of its triangles.
static func _simplify(im: ImporterMesh, keep: float) -> void:
	im.generate_lods(60.0, 25.0, [])
	var surfaces := []
	for i in im.get_surface_count():
		var arrays := im.get_surface_arrays(i)
		var want := int(arrays[Mesh.ARRAY_INDEX].size() * keep)
		var lods := {}
		for l in im.get_surface_lod_count(i):
			var idx := im.get_surface_lod_indices(i, l)
			if arrays[Mesh.ARRAY_INDEX].size() > want and idx.size() <= maxi(want, 3):
				arrays[Mesh.ARRAY_INDEX] = idx
			elif idx.size() < arrays[Mesh.ARRAY_INDEX].size():
				lods[im.get_surface_lod_size(i, l)] = idx
		surfaces.append([arrays, lods, im.get_surface_material(i), im.get_surface_name(i), im.get_surface_format(i) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS])
	im.clear()
	for s: Array in surfaces:
		im.add_surface(Mesh.PRIMITIVE_TRIANGLES, s[0], [], s[1], s[2], s[3], s[4])


static func open(scene: PackedScene, tint: Color, from := "") -> Avatar:
	var a := Avatar.new()
	a.source = from
	a._model = scene.instantiate()
	a.add_child(a._model)
	a._facing = FACING if (a._model.get_meta("forward", Vector3.BACK) as Vector3).z > 0.0 else Basis.IDENTITY
	var bones: Dictionary = a._model.get_meta("humanoid")
	for b: String in bones:
		var j := Joint.new()
		var path: NodePath = bones[b]
		j.node = a._model.get_node(path)
		if j.node is Skeleton3D:
			j.bone = (j.node as Skeleton3D).find_bone(path.get_concatenated_subnames())
			j.rest = _space(j.node, a._model) * (j.node as Skeleton3D).get_bone_global_rest(j.bone)
		else:
			j.rest = _space(j.node, a._model)
		a._joints[b] = j
	var head: Joint = a._joints.head
	var eye_at := head.rest * (a._model.get_meta("eyes") as Vector3)
	a._eye_to_head = Transform3D(a._facing, eye_at).affine_inverse() * head.rest
	for s in 2:
		var side: String = ["left", "right"][s]
		var hand: Joint = a._joints[side + "Hand"]
		var from_bone: Joint = a._joints.get(side + "LowerArm", a._joints.get(side + "UpperArm"))
		var along := a._facing * (hand.rest.origin - from_bone.rest.origin) if from_bone else Vector3(1 - 2 * s, 0, 0)
		# A VRM rests in T-pose, palms down; a hand holding a controller points along it, palm inward.
		var held := _frame(Vector3.FORWARD, Vector3(signf(along.x), 0, 0) * -1.0) * _frame(along, Vector3.DOWN).transposed()
		a._grip[s] = held * a._facing * hand.rest.basis
	a._dress(a._model, tint)
	return a


## A node's transform relative to `root`, whether or not it is in the tree.
static func _space(n: Node3D, root: Node3D) -> Transform3D:
	var t := Transform3D.IDENTITY
	while n != root:
		t = n.transform * t
		n = n.get_parent()
	return t


## A basis whose X runs along `along` and Y toward `toward`.
static func _frame(along: Vector3, toward: Vector3) -> Basis:
	var x := along.normalized()
	var y := (toward - x * toward.dot(x)).normalized()
	return Basis(x, y, x.cross(y))


func _get_joint(j: Joint) -> Transform3D:
	if j.bone >= 0:
		return _space(j.node, _model) * (j.node as Skeleton3D).get_bone_global_pose(j.bone)
	return _space(j.node, _model)


## Puts a bone at `xform` in this node's space, whatever its parent bones' poses.
func _place(j: Joint, xform: Transform3D) -> void:
	if j.bone >= 0:
		(j.node as Skeleton3D).set_bone_global_pose(j.bone, _space(j.node, _model).affine_inverse() * xform)
	else:
		j.node.transform = _space(j.node.get_parent_node_3d(), _model).affine_inverse() * xform


## A bone's transform in the world, by its VRM name.
func bone(name: String) -> Transform3D:
	return global_transform * _get_joint(_joints[name])


## Tints the tint surfaces; avatars cast no shadow, since a shadow pass would double their draw calls.
func _dress(n: Node, tint: Color) -> void:
	if n is MeshInstance3D:
		var mi: MeshInstance3D = n
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		for i in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(i)
			if m is StandardMaterial3D and m.resource_name.begins_with("tint"):
				var t: StandardMaterial3D = m.duplicate()
				t.albedo_color = tint
				mi.set_surface_override_material(i, t)
	for c in n.get_children():
		_dress(c, tint)


## Poses of the eyes and the two hands' aim poses, in this node's space (the world's, for a player). Only the
## tracked parts are placed: the body hangs upright from the head bone in its rest pose, and each arm is the one
## bend that joins its shoulder to its hand.
func pose(at: Transform3D, l: Transform3D, r: Transform3D) -> void:
	eyes = at
	hands = [l, r]
	var turn := Basis(Vector3.UP, at.basis.get_euler().y)
	var head := at * _eye_to_head
	var body := turn * _facing
	var hips: Joint = _joints.hips
	var h: Joint = _joints.head
	_place(hips, Transform3D(body, head.origin - body * h.rest.origin) * hips.rest)
	_place(h, head)
	for s in 2:
		var side: String = ["left", "right"][s]
		var grip := Transform3D(hands[s].basis * _grip[s], hands[s].origin)
		_arm(_joints.get(side + "UpperArm"), _joints.get(side + "LowerArm"), _joints[side + "Hand"], grip, turn, body)
		_place(_joints[side + "Hand"], grip)


func _arm(upper: Joint, lower: Joint, hand: Joint, to: Transform3D, turn: Basis, body: Basis) -> void:
	if upper == null or lower == null:
		return
	var shoulder := _get_joint(upper).origin
	var a := lower.rest.origin.distance_to(upper.rest.origin)
	var b := hand.rest.origin.distance_to(lower.rest.origin)
	var reach := to.origin - shoulder
	var c := clampf(reach.length(), absf(a - b) + 0.001, a + b - 0.0001)
	var u := reach.normalized() if reach.length() > 0.001 else turn * Vector3.DOWN
	var out := signf((_facing * (hand.rest.origin - upper.rest.origin)).x)
	var pole := turn * (ELBOW * Vector3(out, 1, 1))
	var p := (pole - u * pole.dot(u)).normalized()
	var cos_a := (a * a + c * c - b * b) / (2.0 * a * c)
	var elbow := shoulder + u * a * cos_a + p * a * sqrt(maxf(0.0, 1.0 - cos_a * cos_a))
	var back := turn * Vector3.BACK
	var bend := _frame(elbow - shoulder, p) * _frame(body * (lower.rest.origin - upper.rest.origin), back).transposed()
	_place(upper, Transform3D(bend * body * upper.rest.basis, shoulder))
	bend = _frame(to.origin - elbow, p) * _frame(body * (hand.rest.origin - lower.rest.origin), back).transposed()
	_place(lower, Transform3D(bend * body * lower.rest.basis, elbow))


## Standing still with the hands at the sides, as a figure.
func stand() -> void:
	var at := Transform3D(Basis.IDENTITY, Vector3(0, 1.65, 0))
	pose(at, Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(-0.3, 1.0, 0.05)), Transform3D(Basis(Vector3.RIGHT, -1.2), Vector3(0.3, 1.0, 0.05)))
