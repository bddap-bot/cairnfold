extends "res://../tests/support/suite.gd"


func _initialize() -> void:
	check(not PlayLog.enabled({}), "default does not opt in")
	check(PlayLog.open_enabled({}) == null, "default creates no recorder")
	check(PlayLog.enabled({"record-sessions": true}), "explicit launch opts in")
	FileAccess.open(Main.player_path(PlayLog.SWITCH), FileAccess.WRITE).close()
	var switched := PlayLog.open_enabled({})
	check(switched != null and switched.directory == Main.player_path("sessions"), "the switch file in the player folder opts in, recording beside it")
	switched.finish()
	for name in DirAccess.get_files_at(switched.directory):
		DirAccess.remove_absolute(switched.directory.path_join(name))
	check(PlayLog.open_enabled({"forget-sessions": true}) == null and not PlayLog.enabled({}), "forgetting removes the switch")
	var folder := "user://test-play-%d" % OS.get_process_id()
	check(not DirAccess.dir_exists_absolute(folder), "default constructs no logger and writes nothing")
	var earlier := PlayLog.new(folder)
	for i in 70:
		earlier.sample({"unix": float(i), "head_position": [1, 2, 3], "view_direction": [0, 0, -1]})
		earlier._join()
		earlier._open()
	earlier.finish()
	var kept := Array(DirAccess.get_files_at(folder))
	check(kept.size() == 71, "a session keeps every chunk it wrote: %d of 71" % kept.size())
	var logger := PlayLog.new(folder)
	logger.sample({"unix": 21.0, "padding": "x".repeat(PlayLog.MAX_BYTES * 3 / 5)})
	logger._join()
	logger.sample({"unix": 21.0, "padding": "x".repeat(PlayLog.MAX_BYTES * 3 / 5)})
	logger._join()
	var files := Array(DirAccess.get_files_at(folder))
	check(kept.all(func(f: String) -> bool: return f in files) and files.size() == 73,
		"the next session deletes none of the last's chunks, which only the host knows it has copied")
	logger.min_free = 1 << 62
	logger.sample({"unix": 22.0, "padding": "x".repeat(PlayLog.MAX_BYTES * 3 / 5)})
	logger._join()
	check(logger.ended(), "a device short of storage ends the session's record")
	logger.sample({"unix": 23.0})
	logger.finish()
	check(Array(DirAccess.get_files_at(folder)) == files, "and deletes nothing, nor writes another chunk")
	var last: String = files.filter(func(f: String) -> bool: return f.begins_with(logger.session_id)).max()
	var lines := FileAccess.get_file_as_string(folder.path_join(last)).strip_edges().split("\n")
	var end: Dictionary = JSON.parse_string(lines[-1])
	check(end.event == "end" and end.get("stopped") == "storage", "its last chunk closes on an end record saying why: %s" % [end])
	for name in files:
		var f := FileAccess.open(folder.path_join(name), FileAccess.READ)
		check(f.get_length() <= PlayLog.MAX_BYTES, "chunk is bounded")
		f.close()
		DirAccess.remove_absolute(folder.path_join(name))
	DirAccess.remove_absolute(folder)
	finish()
